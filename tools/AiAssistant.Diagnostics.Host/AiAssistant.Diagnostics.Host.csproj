<Project Sdk="Microsoft.NET.Sdk">
  <!-- 专用宿主：只承载 E2E 自驱动与基准命令，绝不随产品安装包发布。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>Developer-only host for UI E2E self-driving and recognition/retrieval benchmarks.</Description>
    <RootNamespace>AiAssistant.Diagnostics.Host</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- 基准/评测与 UI 自驱动源码物理归属本工具宿主，产品程序集不再链接或排除它们。 -->
    <EmbeddedResource Include="Resources/TSCharacters.txt"
                      LogicalName="AiAssistant.Processing.Benchmarks.TSCharacters.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/AiAssistant.Application/AiAssistant.Application.csproj" />
    <ProjectReference Include="../../src/AiAssistant.Core/AiAssistant.Core.csproj" />
    <ProjectReference Include="../../src/AiAssistant.Desktop/AiAssistant.Desktop.csproj" />
    <ProjectReference Include="../../src/AiAssistant.Export/AiAssistant.Export.csproj" />
    <ProjectReference Include="../../src/AiAssistant.Host/AiAssistant.Host.csproj" />
    <ProjectReference Include="../../src/AiAssistant.Models/AiAssistant.Models.csproj" />
    <ProjectReference Include="../../src/AiAssistant.Platform.Linux/AiAssistant.Platform.Linux.csproj" />
    <ProjectReference Include="../../src/AiAssistant.Processing/AiAssistant.Processing.csproj" />
    <ProjectReference Include="../../src/AiAssistant.Summarization/AiAssistant.Summarization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <!-- 基准源码以链接方式编译进本程序集；内部 DTO 仅对对应单测工程可见。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="AiAssistant.Processing.Tests" />
  </ItemGroup>
</Project>
