<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="AiAssistant"
    Manufacturer="AiAssistant"
    Version="$(var.Version)"
    UpgradeCode="7D6F4B5E-3A21-4C8B-9E7A-2F1D8C6B5A40"
    Language="2052"
    Scope="perMachine"
    Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="已安装更高版本的时光，请先卸载。" />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(var.SourceDir)\aiassistant.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/gaozeqian/AiAssistant" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AiAssistant">
        <Files Include="$(var.SourceDir)\**" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="AiAssistant">
        <Component Id="StartMenuShortcut" Guid="B2C3D4E5-6F70-4812-9A3B-4C5D6E7F8091">
          <Shortcut Id="AppShortcut"
                    Name="时光"
                    Description="本地加密的活动记录、日报与证据问答"
                    Target="[INSTALLFOLDER]AiAssistant.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon" />
          <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\AiAssistant" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- 仅在显式 DEVSELFSIGNED=1（开发自签名）时导入根证书；正式 CA 签名 installer 不修改信任库。 -->
    <Property Id="DEVSELFSIGNED" Value="0" />
    <CustomAction Id="SetImportRootCertData" Property="ImportRootCert" Value="[INSTALLFOLDER]" />
    <CustomAction Id="SetImportTrustedPeopleData" Property="ImportTrustedPeople" Value="[INSTALLFOLDER]" />
    <CustomAction Id="ImportRootCert"
                  Directory="SystemFolder"
                  ExeCommand="certutil.exe -addstore -f Root &quot;[CustomActionData]AiAssistant.cer&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />
    <CustomAction Id="ImportTrustedPeople"
                  Directory="SystemFolder"
                  ExeCommand="certutil.exe -addstore -f TrustedPeople &quot;[CustomActionData]AiAssistant.cer&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <InstallExecuteSequence>
      <Custom Action="SetImportRootCertData" After="InstallFiles" Condition="DEVSELFSIGNED = 1 AND NOT Installed" />
      <Custom Action="SetImportTrustedPeopleData" After="SetImportRootCertData" Condition="DEVSELFSIGNED = 1 AND NOT Installed" />
      <Custom Action="ImportRootCert" After="SetImportTrustedPeopleData" Condition="DEVSELFSIGNED = 1 AND NOT Installed" />
      <Custom Action="ImportTrustedPeople" After="ImportRootCert" Condition="DEVSELFSIGNED = 1 AND NOT Installed" />
    </InstallExecuteSequence>
  </Package>
</Wix>
