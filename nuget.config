<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 单一可信源：清除机器级配置中的其他源，避免依赖混淆/包替换攻击。 -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </auditSources>

  <!-- 所有包（含传递依赖）只能来自 nuget.org；新增源必须同时新增映射。 -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
