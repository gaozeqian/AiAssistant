<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Description>Composition Root, startup, DI registration, OS platform wiring, and application lifecycle.</Description>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('Windows'))">..\..\build\package\assets\aiassistant.ico</ApplicationIcon>
    <MacHelperBinaryPath>$(MSBuildProjectDirectory)/../../native/AiAssistant.MacHelper/.build/release/aiassistant-mac-helper</MacHelperBinaryPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AiAssistant.Core\AiAssistant.Core.csproj" />
    <ProjectReference Include="..\AiAssistant.Application\AiAssistant.Application.csproj" />
    <ProjectReference Include="..\AiAssistant.Capture\AiAssistant.Capture.csproj" />
    <ProjectReference Include="..\AiAssistant.Processing\AiAssistant.Processing.csproj" />
    <ProjectReference Include="..\AiAssistant.Storage\AiAssistant.Storage.csproj" />
    <ProjectReference Include="..\AiAssistant.Models\AiAssistant.Models.csproj" />
    <ProjectReference Include="..\AiAssistant.Summarization\AiAssistant.Summarization.csproj" />
    <ProjectReference Include="..\AiAssistant.Scheduler\AiAssistant.Scheduler.csproj" />
    <ProjectReference Include="..\AiAssistant.Voice\AiAssistant.Voice.csproj" />
    <ProjectReference Include="..\AiAssistant.LocalApi\AiAssistant.LocalApi.csproj" />
    <ProjectReference Include="..\AiAssistant.Export\AiAssistant.Export.csproj" />
    <ProjectReference Include="..\AiAssistant.Platform.Windows\AiAssistant.Platform.Windows.csproj" />
    <ProjectReference Include="..\AiAssistant.Platform.MacOS\AiAssistant.Platform.MacOS.csproj" />
    <ProjectReference Include="..\AiAssistant.Platform.Linux\AiAssistant.Platform.Linux.csproj" />
    <ProjectReference Include="..\AiAssistant.Desktop\AiAssistant.Desktop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Wayland" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <Target Name="BundleMacOsSwiftHelper" AfterTargets="Publish" Condition="$([MSBuild]::IsOsPlatform('OSX')) And Exists('$(MacHelperBinaryPath)')">
    <Copy SourceFiles="$(MacHelperBinaryPath)" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
