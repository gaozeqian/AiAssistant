<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Avalonia 12 MVVM Views and ViewModels. Calls only Application use cases.</Description>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AiAssistant.Application\AiAssistant.Application.csproj" />
    <ProjectReference Include="..\AiAssistant.Core\AiAssistant.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <!-- 唯一图标源在 build/package/assets；此处只做链接嵌入，避免重复二进制资产。 -->
    <EmbeddedResource Include="../../build/package/assets/aiassistant.png"
                      LogicalName="AiAssistant.Desktop.Assets.aiassistant.png"
                      Link="Assets/aiassistant.png" />
  </ItemGroup>
  <ItemGroup>
    <!-- UI 自驱动 E2E 只由工具宿主编译。 -->
    <Compile Remove="UiE2ERunner.cs" />
  </ItemGroup>
</Project>
