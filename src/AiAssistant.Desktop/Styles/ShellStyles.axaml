<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <StreamGeometry x:Key="CompactSpinnerIncreaseIcon">M0,9 L10,0 20,9 19,10 10,2 1,10 z</StreamGeometry>
    <StreamGeometry x:Key="CompactSpinnerDecreaseIcon">M0,1 L10,10 20,1 19,0 10,8 1,0 z</StreamGeometry>

    <!--
      主按钮必须显式接管三态：Fluent 的 Button 模板在 :pointerover / :pressed 时改的是
      模板内 ContentPresenter.Background，而不是 Button.Background。只在样式里设 Background
      会让按钮在悬停时变成 10% 黑白叠加、按下时变成纯白/纯黑，白色文字随之不可读。
    -->
    <ControlTheme x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="CornerRadius" Value="7" />
      <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
      </Style>
      <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
      </Style>
      <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentDisabledBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccentDisabledBrush}" />
      </Style>
    </ControlTheme>

    <!-- Fluent 默认把两个 34×32 的箭头左右并排，占掉一半输入框；这里改为 18×14 上下排列。 -->
    <ControlTheme x:Key="CompactSpinnerButton" TargetType="RepeatButton">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Root" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusXs}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource RepeatButtonBackgroundPointerOver}" />
      </Style>
      <Style Selector="^:pressed /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource RepeatButtonBackgroundPressed}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.4" />
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="CompactNumericSpinner" TargetType="ButtonSpinner">
      <Setter Property="Template">
        <ControlTemplate>
          <DataValidationErrors>
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    MinHeight="{TemplateBinding MinHeight}">
              <DockPanel>
                <StackPanel Name="PART_SpinnerPanel"
                            DockPanel.Dock="Right"
                            Orientation="Vertical"
                            VerticalAlignment="Center"
                            Margin="0,0,2,0"
                            IsVisible="{TemplateBinding ShowButtonSpinner}">
                  <RepeatButton Name="PART_IncreaseButton"
                                Theme="{StaticResource CompactSpinnerButton}"
                                IsTabStop="{TemplateBinding IsTabStop}"
                                Foreground="{TemplateBinding Foreground}">
                    <PathIcon Width="8" Height="4" Data="{StaticResource CompactSpinnerIncreaseIcon}" />
                  </RepeatButton>
                  <RepeatButton Name="PART_DecreaseButton"
                                Theme="{StaticResource CompactSpinnerButton}"
                                IsTabStop="{TemplateBinding IsTabStop}"
                                Foreground="{TemplateBinding Foreground}">
                    <PathIcon Width="8" Height="4" Data="{StaticResource CompactSpinnerDecreaseIcon}" />
                  </RepeatButton>
                </StackPanel>
                <ContentPresenter Name="PART_ContentPresenter"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Content="{TemplateBinding Content}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Padding="{TemplateBinding Padding}" />
              </DockPanel>
            </Border>
          </DataValidationErrors>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <!-- 破坏性操作：红色描边 + 悬停红底。和主按钮一样，三态必须落在模板 ContentPresenter 上。 -->
    <ControlTheme x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerForegroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
      <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerForegroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
      </Style>
      <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerForegroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
      </Style>
    </ControlTheme>
  </Styles.Resources>

  <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner">
    <Setter Property="Theme" Value="{StaticResource CompactNumericSpinner}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Theme" Value="{StaticResource PrimaryButton}" />
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Theme" Value="{StaticResource DangerButton}" />
  </Style>
  <!-- 顶栏胶囊按钮：状态徽标不可点，只有这两个是按钮，用同一套尺寸。 -->
  <Style Selector="Button.headerChip">
    <Setter Property="Background" Value="{DynamicResource HeaderBadgeBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HeaderBadgeForegroundBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
  </Style>
  <Style Selector="Button.headerChip.headerDanger">
    <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
  </Style>
  <Style Selector="Button.headerChip.armed">
    <Setter Property="Background" Value="{DynamicResource DangerBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBox, ComboBox, DatePicker">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="DatePicker /template/ TextBox">
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <!-- 弱化说明文字：颜色 + 换行，不强制字号（正文/说明各自用 FontSize 令牌）。 -->
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- 能力状态：默认正文色，需要关注时用警示色；文字本身（可用/降级）始终存在，不单靠颜色。 -->
  <Style Selector="TextBlock.status">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.status.attention">
    <Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TabControl TabItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="Padding" Value="12,7" />
  </Style>
  <Style Selector="TabControl TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ListSelectionBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
</Styles>
