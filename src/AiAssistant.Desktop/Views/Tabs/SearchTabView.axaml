<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AiAssistant.Desktop.ViewModels"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="AiAssistant.Desktop.Views.Tabs.SearchTabView"
             x:DataType="vm:ShellViewModel">
  <!-- 左栏与时间线/日报统一 360：三屏切换时列表宽度不再跳变。 -->
  <Grid DataContext="{Binding Search}" x:DataType="vm:SearchViewModel"
        ColumnDefinitions="360,*" Margin="0,12,0,0">
    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="{DynamicResource RadiusMd}" Padding="{DynamicResource SpaceLg}" Margin="0,0,12,0">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
        <TextBlock Text="证据检索与问答" FontSize="{DynamicResource FontSizePage}" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Spacing="{DynamicResource SpacingSm}" Margin="0,14,0,0">
          <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                   PlaceholderText="输入关键词或问题，例如：迁移进展如何"
                   automation:AutomationProperties.Name="检索关键词或问题" />
          <!-- 标签在上：40px 行内标签会让 DatePicker 的最小宽度撑出卡片 20px。 -->
          <StackPanel Spacing="{DynamicResource SpacingXs}" Margin="0,4,0,0">
            <TextBlock Text="从" Classes="muted" />
            <DatePicker SelectedDate="{Binding FromDate}" Initialized="OnDatePickerInitialized"
                        HorizontalAlignment="Stretch"
                        automation:AutomationProperties.Name="检索起始日期" />
          </StackPanel>
          <StackPanel Spacing="{DynamicResource SpacingXs}" Margin="0,6,0,0">
            <TextBlock Text="到" Classes="muted" />
            <DatePicker SelectedDate="{Binding ToDate}" Initialized="OnDatePickerInitialized"
                        HorizontalAlignment="Stretch"
                        automation:AutomationProperties.Name="检索结束日期" />
          </StackPanel>
        </StackPanel>
        <!-- 与 日报/周报 一致：三按钮等宽排布，宽度与上方输入框对齐。 -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="6" Margin="0,12,0,0">
          <Button Classes="primary reportAction" Content="检索证据" Command="{Binding SearchCommand}"
                  IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch"
                  automation:AutomationProperties.Name="检索证据" />
          <Button Grid.Column="1" Classes="secondary reportAction" Content="提问" Command="{Binding AskCommand}"
                  IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch"
                  automation:AutomationProperties.Name="基于证据提问" />
          <Button Grid.Column="2" Classes="secondary reportAction" Content="导出问答"
                  Command="{Binding ExportAnswerCommand}" IsEnabled="{Binding HasAnswer}"
                  HorizontalAlignment="Stretch"
                  automation:AutomationProperties.Name="导出问答" />
        </Grid>
        <ProgressBar Grid.Row="3" Minimum="0" Maximum="100" Value="{Binding ProgressPulse}" IsVisible="{Binding IsBusy}" />
        <StackPanel Grid.Row="4" Spacing="{DynamicResource SpacingXs}" Margin="0,8,0,0">
          <TextBlock Text="{Binding StatusMessage}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ErrorMessage}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource DangerForegroundBrush}" TextWrapping="Wrap"
                     IsVisible="{Binding HasError}" Classes.appear="{Binding HasError}" />
        </StackPanel>
        <!-- 回答可能很长：必须自己滚动，否则最小窗口下会被卡片硬切。 -->
        <ScrollViewer Grid.Row="5" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <Border Background="{DynamicResource SubtleCardBrush}" CornerRadius="{DynamicResource RadiusSm}" Padding="{DynamicResource SpaceMd}">
            <StackPanel Spacing="{DynamicResource SpacingSm}">
              <TextBlock Text="回答（仅基于证据）" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Answer}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding AnswerMeta}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
              <Border Background="{DynamicResource SuccessBackgroundBrush}" CornerRadius="{DynamicResource RadiusSm}" Padding="{DynamicResource SpaceMd}">
                <TextBlock Text="无证据时不会生成推测性回答；原始媒体清理后只保留结构化证据。"
                           FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource SuccessForegroundBrush}" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </Grid>
    </Border>

    <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="{DynamicResource RadiusMd}" Padding="{DynamicResource SpaceLg}">
      <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="证据列表" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" />
          <TextBlock Grid.Column="1" Text="点击“定位”跳转到时间线对应记录"
                     FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="1" Margin="0,10,0,0">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Evidence}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EvidenceCardItem">
                  <Border Background="{DynamicResource SubtleCardBrush}" CornerRadius="{DynamicResource RadiusSm}" Padding="{DynamicResource SpaceMd}" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="{DynamicResource SpacingXs}">
                        <TextBlock Text="{Binding Header}" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextBrush}" />
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Excerpt}" FontSize="{DynamicResource FontSizeBody}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding MatchedByText}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Text="{Binding MediaText}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource MutedBrush}" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="secondary" Content="定位"
                              Command="{Binding NavigateCommand}" VerticalAlignment="Top"
                              automation:AutomationProperties.Name="定位到时间线对应记录" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Text="暂无证据。先输入关键词检索，或放宽日期范围。"
                     Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                     IsVisible="{Binding ShowEvidenceEmpty}" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
