<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AiAssistant.Desktop.ViewModels"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="AiAssistant.Desktop.Views.Tabs.DataExportTabView"
             x:DataType="vm:ShellViewModel">
  <ScrollViewer DataContext="{Binding Data}" x:DataType="vm:DataManagementViewModel" Margin="0,12,0,0">
    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="{DynamicResource ScrollGutterMargin}">
      <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="{DynamicResource RadiusMd}" Padding="{DynamicResource SpaceXl}" Margin="0,0,8,12">
        <StackPanel Spacing="{DynamicResource SpacingLg}">
          <TextBlock Text="删除本地数据" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding RetentionNotice}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
          <DatePicker SelectedDate="{Binding SelectedDate}" Initialized="OnDatePickerInitialized"
                      automation:AutomationProperties.Name="要删除的日期" />
          <WrapPanel>
            <Button Classes="danger" Content="{Binding DeleteDateButtonText}"
                    Command="{Binding DeleteDateCommand}" IsEnabled="{Binding !IsBusy}" Margin="0,0,8,8"
                    automation:AutomationProperties.Name="{Binding DeleteDateButtonText}" />
            <Button Classes="danger" Content="{Binding DeleteAllButtonText}"
                    Command="{Binding DeleteAllCommand}" IsEnabled="{Binding !IsBusy}" Margin="0,0,8,8"
                    automation:AutomationProperties.Name="{Binding DeleteAllButtonText}" />
            <Button Classes="secondary" Content="取消" Command="{Binding CancelPendingCommand}"
                    IsVisible="{Binding HasPendingDeletion}" IsEnabled="{Binding !IsBusy}" Margin="0,0,8,8" />
          </WrapPanel>
          <Border Background="{DynamicResource DangerBackgroundBrush}" CornerRadius="{DynamicResource RadiusSm}" Padding="{DynamicResource SpaceMd}" IsVisible="{Binding HasPendingDeletion}">
            <TextBlock Text="{Binding PendingText}" Foreground="{DynamicResource DangerForegroundBrush}" TextWrapping="Wrap" />
          </Border>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPulse}" IsVisible="{Binding IsDeleting}"
                       automation:AutomationProperties.Name="删除进度" />
          <TextBlock Text="{Binding DeleteStatusMessage}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding DeleteErrorMessage}" Foreground="{DynamicResource DangerForegroundBrush}" TextWrapping="Wrap"
                     IsVisible="{Binding HasDeleteError}" />
        </StackPanel>
      </Border>

      <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="{DynamicResource RadiusMd}" Padding="{DynamicResource SpaceXl}" Margin="8,0,0,12">
        <StackPanel Spacing="{DynamicResource SpacingLg}">
          <TextBlock Text="导出与保留" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ExportNotice}" TextWrapping="Wrap" />
          <Border Background="{DynamicResource SuccessBackgroundBrush}" CornerRadius="{DynamicResource RadiusSm}" Padding="{DynamicResource SpaceMd}">
            <TextBlock Text="所有导出均在本机生成，不经过云端。删除数据前请先导出需要保留的日报、问答或加密备份。"
                       TextWrapping="Wrap" Foreground="{DynamicResource SuccessForegroundBrush}" />
          </Border>
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="{DynamicResource RadiusMd}"
              Padding="{DynamicResource SpaceXl}" Margin="0,0,0,12" IsVisible="{Binding HasBackupSupport}">
        <StackPanel Spacing="{DynamicResource SpacingMd}">
          <TextBlock Text="数据备份与恢复" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" />
          <TextBlock Text="加密备份是可跨机器迁移的独立 ZIP（数据库 + 媒体 + 主密钥），使用导出时生成的备份密钥加密。密钥不会保存在应用内，请与备份文件分开保存；丢失密钥后备份无法恢复。恢复会先解密校验，重启后覆盖当前数据库与媒体。"
                     TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
          <WrapPanel>
            <Button Classes="secondary" Content="导出加密备份…" Command="{Binding BackupCommand}"
                    IsEnabled="{Binding CanStartBackup}" IsVisible="{Binding !IsAwaitingBackupKey}" Margin="0,0,8,8"
                    automation:AutomationProperties.Name="导出加密备份" />
            <Button Classes="secondary" Content="{Binding RestoreButtonText}" Command="{Binding RestoreCommand}"
                    IsEnabled="{Binding CanStartRestore}" IsVisible="{Binding !IsAwaitingRestoreKey}" Margin="0,0,8,8"
                    automation:AutomationProperties.Name="从备份恢复" />
            <Button Classes="secondary" Content="取消" Command="{Binding CancelPendingCommand}"
                    IsVisible="{Binding HasPendingRestore}" IsEnabled="{Binding !IsBusy}" Margin="0,0,8,8" />
            <Button Classes="primary" Content="立即重启" Command="{Binding RestartCommand}"
                    IsVisible="{Binding RestartAvailable}" Margin="0,0,8,8"
                    automation:AutomationProperties.Name="重启应用完成恢复" />
            <Button Classes="secondary" Content="取消暂存的恢复" Command="{Binding CancelStagedRestoreCommand}"
                    IsVisible="{Binding RestartAvailable}" IsEnabled="{Binding !IsBusy}" Margin="0,0,8,8"
                    automation:AutomationProperties.Name="取消暂存的恢复" />
          </WrapPanel>
          <Border Background="{DynamicResource SubtleCardBrush}" CornerRadius="{DynamicResource RadiusSm}" Padding="{DynamicResource SpaceMd}"
                  IsVisible="{Binding IsAwaitingBackupKey}">
            <StackPanel Spacing="{DynamicResource SpacingMd}">
              <TextBlock Text="请保存备份密钥" FontWeight="SemiBold" />
              <TextBlock Text="这是恢复该备份的唯一密钥，不会保存在应用内。请立即保存到密码管理器或离线位置；丢失后备份无法恢复。任何同时获得密钥和备份文件的人都能读取其中的全部数据，请勿将两者放在一起。"
                         TextWrapping="Wrap" Foreground="{DynamicResource DangerForegroundBrush}" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="BackupKeyBox" Text="{Binding PendingBackupKey, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="Cascadia Mono,Consolas,monospace" TextWrapping="Wrap"
                         automation:AutomationProperties.Name="备份密钥" />
                <Button Grid.Column="1" Classes="secondary" Content="复制密钥" Click="OnCopyBackupKeyClick"
                        Margin="8,0,0,0" automation:AutomationProperties.Name="复制备份密钥" />
              </Grid>
              <CheckBox IsChecked="{Binding BackupKeyConfirmed, Mode=TwoWay}"
                        IsVisible="{Binding !BackupExportCompleted}" IsEnabled="{Binding !IsBusy}"
                        automation:AutomationProperties.Name="确认已保存备份密钥">
                <TextBlock Text="我已安全保存密钥，并了解丢失后无法恢复" TextWrapping="Wrap" />
              </CheckBox>
              <WrapPanel>
                <Button Classes="primary" Content="{Binding BackupKeyActionText}" Command="{Binding ConfirmBackupCommand}"
                        IsEnabled="{Binding CanConfirmBackup}" Margin="0,0,8,8"
                        automation:AutomationProperties.Name="{Binding BackupKeyActionText}" />
                <Button Classes="secondary" Content="取消" Command="{Binding CancelBackupKeyCommand}"
                        IsVisible="{Binding !BackupExportCompleted}" IsEnabled="{Binding !IsBusy}" Margin="0,0,8,8" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource SubtleCardBrush}" CornerRadius="{DynamicResource RadiusSm}" Padding="{DynamicResource SpaceMd}"
                  IsVisible="{Binding IsAwaitingRestoreKey}">
            <StackPanel Spacing="{DynamicResource SpacingMd}">
              <TextBlock Text="输入备份密钥" FontWeight="SemiBold" />
              <TextBlock Text="输入导出时保存的备份密钥。密钥不区分大小写，可包含分隔符；解密校验通过后才会覆盖当前数据。"
                         TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
              <TextBox Text="{Binding RestoreKeyInput, Mode=TwoWay}" PlaceholderText="XXXX-XXXX-XXXX-…"
                       FontFamily="Cascadia Mono,Consolas,monospace"
                       automation:AutomationProperties.Name="备份密钥输入" />
              <WrapPanel>
                <Button Classes="primary" Content="解密并校验" Command="{Binding ValidateRestoreKeyCommand}"
                        IsEnabled="{Binding CanValidateRestoreKey}" Margin="0,0,8,8"
                        automation:AutomationProperties.Name="解密并校验备份" />
                <Button Classes="secondary" Content="取消" Command="{Binding CancelRestoreKeyCommand}"
                        IsEnabled="{Binding !IsBusy}" Margin="0,0,8,8" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource DangerBackgroundBrush}" CornerRadius="{DynamicResource RadiusSm}" Padding="{DynamicResource SpaceMd}" IsVisible="{Binding HasPendingRestore}">
            <TextBlock Text="{Binding PendingText}" Foreground="{DynamicResource DangerForegroundBrush}" TextWrapping="Wrap" />
          </Border>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPulse}" IsVisible="{Binding IsBackingUp}"
                       automation:AutomationProperties.Name="备份恢复进度" />
          <TextBlock Text="{Binding BackupStatusMessage}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding BackupErrorMessage}" Foreground="{DynamicResource DangerForegroundBrush}" TextWrapping="Wrap"
                     IsVisible="{Binding HasBackupError}" />
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="{DynamicResource RadiusMd}"
              Padding="{DynamicResource SpaceXl}" IsVisible="{Binding HasRetentionSettings}">
        <StackPanel Spacing="{DynamicResource SpacingMd}">
          <TextBlock Text="保留与清理" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding RetentionPolicyText}" Foreground="{DynamicResource AccentTextBrush}" TextWrapping="Wrap" />
          <!-- 标签在上、输入在下：三个标签宽度不同，横排时输入框起点对不齐。 -->
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{DynamicResource SpacingLg}">
            <StackPanel Spacing="{DynamicResource SpacingXs}">
              <TextBlock Text="媒体保留（天）" Classes="muted" />
              <NumericUpDown Value="{Binding MediaRetentionDays, Mode=TwoWay}"
                             Minimum="1" Maximum="365" Increment="1" FormatString="0"
                             Loaded="OnRetentionSpinnerLoaded"
                             automation:AutomationProperties.Name="媒体保留天数" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="{DynamicResource SpacingXs}">
              <TextBlock Text="命令音频保留（天）" Classes="muted" />
              <NumericUpDown Value="{Binding CommandAudioRetentionDays, Mode=TwoWay}"
                             Minimum="1" Maximum="365" Increment="1" FormatString="0"
                             Loaded="OnRetentionSpinnerLoaded"
                             automation:AutomationProperties.Name="命令音频保留天数" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="{DynamicResource SpacingXs}">
              <TextBlock Text="存储上限（GB，0=不限）" Classes="muted" />
              <NumericUpDown Value="{Binding MaxStorageGigabytes, Mode=TwoWay}"
                             Minimum="0" Maximum="1000" Increment="1" FormatString="0"
                             Loaded="OnRetentionSpinnerLoaded"
                             automation:AutomationProperties.Name="存储上限GB" />
            </StackPanel>
          </Grid>
          <TextBlock Text="超过存储上限时，从最旧的媒体开始擦除；结构化事件始终保留，只会失去媒体引用。"
                     TextWrapping="Wrap" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource MutedBrush}" />
          <WrapPanel>
            <Button Classes="primary" Content="保存保留设置" Command="{Binding SaveRetentionCommand}"
                    IsEnabled="{Binding !IsBusy}" Margin="0,0,8,8"
                    automation:AutomationProperties.Name="保存保留设置" />
            <Button Classes="secondary" Content="立即清理" Command="{Binding RunRetentionSweepCommand}"
                    IsEnabled="{Binding !IsBusy}" IsVisible="{Binding HasRetentionSweep}" Margin="0,0,8,8"
                    automation:AutomationProperties.Name="立即清理媒体" />
          </WrapPanel>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPulse}" IsVisible="{Binding IsRetentionBusy}"
                       automation:AutomationProperties.Name="保留清理进度" />
          <TextBlock Text="{Binding RetentionStatusMessage}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding RetentionErrorMessage}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource DangerForegroundBrush}"
                     TextWrapping="Wrap" IsVisible="{Binding HasRetentionError}" />
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
