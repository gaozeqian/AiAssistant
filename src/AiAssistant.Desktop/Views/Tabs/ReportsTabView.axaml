<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AiAssistant.Desktop.ViewModels"
             xmlns:md="using:Markdown.Avalonia"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="AiAssistant.Desktop.Views.Tabs.ReportsTabView"
             x:DataType="vm:ShellViewModel">
  <Grid DataContext="{Binding Reports}" x:DataType="vm:ReportsViewModel"
        ColumnDefinitions="360,*" Margin="0,12,0,0">
    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="{DynamicResource RadiusMd}" Padding="{DynamicResource SpaceLg}" Margin="0,0,12,0">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <TextBlock Text="日报与站会" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" />
        <DatePicker Grid.Row="1" SelectedDate="{Binding SelectedDate}" Margin="0,14,0,10" Initialized="OnDatePickerInitialized"
                    automation:AutomationProperties.Name="日报日期" />
        <WrapPanel Grid.Row="2" Margin="0,0,0,12">
          <Button Classes="primary" Content="生成日报" Command="{Binding GenerateCommand}" Margin="0,0,8,8"
                  automation:AutomationProperties.Name="生成日报" />
          <Button Classes="secondary" Content="强制重生成" Command="{Binding RegenerateCommand}" Margin="0,0,8,8"
                  automation:AutomationProperties.Name="强制重新生成日报" />
          <Button Classes="secondary" Content="刷新" Command="{Binding RefreshCommand}" Margin="0,0,8,8"
                  automation:AutomationProperties.Name="刷新日报版本" />
        </WrapPanel>
        <Border Grid.Row="3" Background="{DynamicResource SubtleCardBrush}" CornerRadius="{DynamicResource RadiusSm}" Padding="{DynamicResource SpaceMd}"
                Margin="0,0,0,12" IsVisible="{Binding HasScheduleSettings}">
          <StackPanel Spacing="{DynamicResource SpacingSm}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="自动日报" FontWeight="SemiBold" />
                <TextBlock Text="检查前一天，有活动才生成" FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource MutedBrush}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding ScheduleEnabled, Mode=TwoWay}"
                            OnContent="开" OffContent="关" VerticalAlignment="Center"
                            automation:AutomationProperties.Name="启用自动日报" />
            </Grid>
            <!-- 标签在上：360px 卡片里横排会把 TimePicker 挤成「0 : 30」。 -->
            <StackPanel Spacing="{DynamicResource SpacingXs}">
              <TextBlock Text="每天" Classes="muted" />
              <TimePicker SelectedTime="{Binding ScheduleTime, Mode=TwoWay}"
                          ClockIdentifier="24HourClock" MinuteIncrement="1" HorizontalAlignment="Stretch"
                          automation:AutomationProperties.Name="自动日报检查时间" />
            </StackPanel>
            <TextBlock Text="启动时也会检查前一天。无日报且有活动记录时生成；已有日报但之后有新活动时自动追加新版本。"
                       FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding ScheduleStatusMessage}" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                         VerticalAlignment="Center" Margin="0,0,8,0" />
              <Button Grid.Column="1" Classes="secondary" Content="保存"
                      Command="{Binding SaveScheduleCommand}" IsEnabled="{Binding !IsScheduleSaving}"
                      automation:AutomationProperties.Name="保存自动日报设置" />
            </Grid>
          </StackPanel>
        </Border>
        <Grid Grid.Row="4">
          <ListBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"
                   Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ReportVersionItem">
                <TextBlock Text="{Binding DisplayText}" Padding="6,8" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPulse}" VerticalAlignment="Top" IsVisible="{Binding IsBusy}" />
          <TextBlock Text="这一天还没有日报。点击「生成日报」创建第一版。"
                     Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                     IsVisible="{Binding !HasVersions}" />
        </Grid>
        <StackPanel Grid.Row="5" Spacing="{DynamicResource SpacingXs}" Margin="0,12,0,0">
          <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerForegroundBrush}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="{DynamicResource RadiusMd}" Padding="{DynamicResource SpaceXl}">
      <Grid RowDefinitions="Auto,*">
        <!-- 头部：标题 + 日报/周报分段开关 + 对应导出动作 -->
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingMd}" VerticalAlignment="Center">
            <TextBlock Text="{Binding ContentTitle}" FontSize="{DynamicResource FontSizePage}" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXs}" VerticalAlignment="Center">
              <Button Content="日报" Classes="segment" Classes.selected="{Binding ShowDailyView}"
                      Command="{Binding ShowDailyCommand}"
                      automation:AutomationProperties.Name="查看日报" />
              <Button Content="周报" Classes="segment" Classes.selected="{Binding IsWeeklyView}"
                      Command="{Binding ShowWeeklyCommand}"
                      automation:AutomationProperties.Name="查看周报" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource SpacingSm}">
            <Button Classes="secondary" Content="导出…" IsVisible="{Binding ShowDailyView}"
                    Command="{Binding ExportCommand}" IsEnabled="{Binding HasReport}"
                    automation:AutomationProperties.Name="导出日报" />
            <Button Classes="primary" Content="生成周报" IsVisible="{Binding IsWeeklyView}"
                    Command="{Binding WeeklyReportCommand}"
                    automation:AutomationProperties.Name="生成周报" />
            <Button Classes="secondary" Content="导出周报…" IsVisible="{Binding IsWeeklyView}"
                    Command="{Binding ExportWeeklyCommand}"
                    automation:AutomationProperties.Name="导出周报" />
          </StackPanel>
          <TextBlock Grid.Row="1" Text="{Binding VersionText}" Foreground="{DynamicResource MutedBrush}"
                     Margin="0,4,0,0" IsVisible="{Binding ShowDailyView}" />
          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding WeeklyStatus}"
                     Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"
                     IsVisible="{Binding IsWeeklyView}" />
        </Grid>

        <!-- 日报正文 -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,12,0,0" IsVisible="{Binding ShowDailyView}">
          <Border Background="{DynamicResource SubtleCardBrush}" CornerRadius="{DynamicResource RadiusSm}"
                  Padding="{DynamicResource SpaceMd}" Margin="0,0,0,12">
            <StackPanel Spacing="{DynamicResource SpacingSm}">
              <TextBlock Text="站会视图" FontWeight="SemiBold" />
              <TextBlock Text="{Binding StandupText}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Grid Grid.Row="1">
            <ScrollViewer>
              <!-- 阅读区限宽：1709px 下 Markdown 会铺满整屏。字号沿用库的 FluentTheme 样式。 -->
              <md:MarkdownScrollViewer Markdown="{Binding Markdown}"
                                       MaxWidth="{DynamicResource ReadingMaxWidth}" HorizontalAlignment="Left" />
            </ScrollViewer>
            <TextBlock Text="还没有可显示的日报正文。先在左侧选择日期并生成。"
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                       IsVisible="{Binding !HasMarkdown}" />
          </Grid>
        </Grid>

        <!-- 周报正文：柱状统计 + 区间报告（原检索页的「周报与统计」） -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,12,0,0" IsVisible="{Binding IsWeeklyView}">
          <ItemsControl ItemsSource="{Binding WeeklyBars}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DailyBarItem">
                <Grid ColumnDefinitions="56,*,90" Margin="0,2">
                  <TextBlock Text="{Binding DateText}" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Height="14" Background="{DynamicResource AccentBrush}"
                          CornerRadius="{DynamicResource RadiusXs}" HorizontalAlignment="Left" Width="{Binding BarWidthPixels}" />
                  <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="{DynamicResource FontSizeBody}"
                             Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid Grid.Row="1" Margin="0,12,0,0">
            <md:MarkdownScrollViewer Markdown="{Binding WeeklyMarkdown}"
                                     MaxWidth="{DynamicResource ReadingMaxWidth}" HorizontalAlignment="Left" />
            <TextBlock Text="还没有周报。点击右上角「生成周报」，按选中日期所在周统计。"
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                       IsVisible="{Binding !HasWeeklyMarkdown}" />
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
