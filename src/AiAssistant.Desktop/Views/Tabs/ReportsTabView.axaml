<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AiAssistant.Desktop.ViewModels"
             xmlns:md="using:Markdown.Avalonia"
             x:Class="AiAssistant.Desktop.Views.Tabs.ReportsTabView"
             x:DataType="vm:ShellViewModel">
  <Grid DataContext="{Binding Reports}" x:DataType="vm:ReportsViewModel"
        ColumnDefinitions="360,*" Margin="0,12,0,0">
    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="18" Margin="0,0,12,0">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <TextBlock Text="日报与站会" FontSize="18" FontWeight="SemiBold" />
        <DatePicker Grid.Row="1" SelectedDate="{Binding SelectedDate}" Margin="0,14,0,10" Initialized="OnDatePickerInitialized" />
        <WrapPanel Grid.Row="2" Margin="0,0,0,12">
          <Button Classes="primary" Content="生成日报" Command="{Binding GenerateCommand}" Margin="0,0,8,8" />
          <Button Classes="secondary" Content="强制重生成" Command="{Binding RegenerateCommand}" Margin="0,0,8,8" />
          <Button Classes="secondary" Content="刷新" Command="{Binding RefreshCommand}" Margin="0,0,8,8" />
        </WrapPanel>
        <Grid Grid.Row="3">
          <ListBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"
                   Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ReportVersionItem">
                <TextBlock Text="{Binding DisplayText}" Padding="6,8" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPulse}" VerticalAlignment="Top" IsVisible="{Binding IsBusy}" />
        </Grid>
        <StackPanel Grid.Row="4" Spacing="5" Margin="0,12,0,0">
          <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerForegroundBrush}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="22">
      <Grid RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Text="日报正文" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding VersionText}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
          </StackPanel>
          <Button Grid.Column="1" Classes="secondary" Content="导出 Markdown"
                  Command="{Binding ExportCommand}" IsEnabled="{Binding HasReport}" />
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource SubtleCardBrush}" CornerRadius="8" Padding="14" Margin="0,14,0,12">
          <StackPanel Spacing="6">
            <TextBlock Text="站会视图" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StandupText}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="2">
          <md:MarkdownScrollViewer Markdown="{Binding Markdown}" />
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
