<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AiAssistant.Desktop.ViewModels"
             xmlns:automation="using:Avalonia.Automation"
             x:Class="AiAssistant.Desktop.Views.Tabs.TimelineTabView"
             x:DataType="vm:ShellViewModel">
  <Grid DataContext="{Binding Timeline}" x:DataType="vm:TimelineViewModel"
        ColumnDefinitions="360,*" Margin="0,12,0,0">
    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="16" Margin="0,0,12,0">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="活动记录" FontSize="15" FontWeight="SemiBold" />
        <ComboBox Grid.Row="1" ItemsSource="{Binding ActiveDates}" SelectedItem="{Binding SelectedDate}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,14,0,10">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:TimelineDateItem">
              <TextBlock Text="{Binding DisplayName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
          <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="搜索应用、标题或正文"
                   automation:AutomationProperties.Name="搜索应用、标题或正文" />
          <Button Grid.Column="1" Classes="secondary" Command="{Binding RefreshCommand}" Content="刷新" Margin="8,0,0,0"
                  automation:AutomationProperties.Name="刷新时间线" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
          <ListBox ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}"
                   Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:TimelineEventItem">
                <Border Padding="10,9" CornerRadius="7" Margin="0,2">
                  <Grid ColumnDefinitions="62,*" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.RowSpan="3" Text="{Binding TimeText}" FontFamily="Consolas" FontSize="12"
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Top" Margin="0,2,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding AppName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Title}" TextWrapping="Wrap"
                               MaxHeight="40" FontSize="12" Margin="0,3,0,0" />
                    <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding SourceText}" FontSize="12"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="暂无可显示的活动" Foreground="{DynamicResource MutedBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding !HasSelectedEvent}" />
          <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" IsVisible="{Binding IsLoading}" />
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,12,0,0" Spacing="5">
          <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{DynamicResource DangerForegroundBrush}" TextWrapping="Wrap"
                     IsVisible="{Binding HasError}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="24">
      <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
          <StackPanel DataContext="{Binding SelectedEvent}" x:DataType="vm:TimelineEventItem" IsVisible="{Binding $parent[Grid].DataContext.HasSelectedEvent}">
            <TextBlock Text="{Binding AppName}" FontSize="13" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,4" />
            <TextBlock Text="{Binding CapturedTimeText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
          </StackPanel>
          <Border Grid.Column="1" Background="{DynamicResource AccentSoftBackgroundBrush}" CornerRadius="6" Padding="9,5" VerticalAlignment="Top">
            <TextBlock Text="仅本机" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
          </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,20,0,0">
          <StackPanel Spacing="16">
            <Border Background="{DynamicResource SubtleCardBrush}" CornerRadius="8" Padding="14" IsVisible="{Binding HasSelectedEvent}">
              <StackPanel DataContext="{Binding SelectedEvent}" x:DataType="vm:TimelineEventItem" Spacing="8">
                <TextBlock Text="活动内容" FontWeight="SemiBold" />
                <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" IsVisible="{Binding HasDetailText}" />
                <TextBlock Text="该事件没有提取文本或摘要。" Foreground="{DynamicResource MutedBrush}"
                           IsVisible="{Binding !HasDetailText}" />
              </StackPanel>
            </Border>

            <StackPanel IsVisible="{Binding HasSelectedEvent}" Spacing="8">
              <TextBlock Text="媒体预览" FontWeight="SemiBold" />
              <TextBlock DataContext="{Binding SelectedEvent}" x:DataType="vm:TimelineEventItem"
                         Text="{Binding MediaSizeText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
              <Border Background="{DynamicResource PlaceholderBrush}" BorderBrush="{DynamicResource DividerBrush}"
                      BorderThickness="1" CornerRadius="8" MinHeight="180" ClipToBounds="True"
                      IsVisible="{Binding HasPreview}">
                <Image Source="{Binding PreviewImage}" Stretch="Uniform" MaxHeight="500" />
              </Border>
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsPreviewLoading}" />
              <Border Background="{DynamicResource WarningBackgroundBrush}" CornerRadius="7" Padding="12" IsVisible="{Binding HasPreviewError}">
                <TextBlock Text="{Binding PreviewError}" Foreground="{DynamicResource WarningForegroundBrush}" TextWrapping="Wrap" />
              </Border>
              <TextBlock Text="此事件没有关联媒体。" Foreground="{DynamicResource MutedBrush}" IsVisible="{Binding HasNoMedia}" />
            </StackPanel>

            <StackPanel IsVisible="{Binding !HasSelectedEvent}" HorizontalAlignment="Center" Margin="0,100,0,0" Spacing="8">
              <TextBlock Text="选择左侧事件开始回看" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Text="媒体只在选中时解密，明文不会写入临时文件" Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
