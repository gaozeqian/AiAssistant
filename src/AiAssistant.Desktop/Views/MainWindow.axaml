<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AiAssistant.Desktop.ViewModels"
        xmlns:automation="using:Avalonia.Automation"
        x:Class="AiAssistant.Desktop.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="时光 · AI 个人活动追踪助手"
        Width="1240"
        Height="800"
        MinWidth="980"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBackgroundBrush}">
  <Window.Styles>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="TextBox, ComboBox, DatePicker">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="DatePicker /template/ TextBox">
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TabControl TabItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="Padding" Value="12,7" />
    </Style>
    <Style Selector="TabControl TabItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ListSelectionBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
  </Window.Styles>

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+D1" Command="{Binding SelectSectionCommand}" CommandParameter="0" />
    <KeyBinding Gesture="Ctrl+D2" Command="{Binding SelectSectionCommand}" CommandParameter="1" />
    <KeyBinding Gesture="Ctrl+D3" Command="{Binding SelectSectionCommand}" CommandParameter="2" />
    <KeyBinding Gesture="Ctrl+D4" Command="{Binding SelectSectionCommand}" CommandParameter="3" />
    <KeyBinding Gesture="Ctrl+D5" Command="{Binding SelectSectionCommand}" CommandParameter="4" />
    <KeyBinding Gesture="Ctrl+D6" Command="{Binding SelectSectionCommand}" CommandParameter="5" />
    <KeyBinding Gesture="Ctrl+D7" Command="{Binding SelectSectionCommand}" CommandParameter="6" />
    <KeyBinding Gesture="Ctrl+F" Command="{Binding ShowSearchCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding RefreshCurrentCommand}" />
  </Window.KeyBindings>

  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource HeaderBorderBrush}"
            BorderThickness="0,0,0,1" Padding="24,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
          <TextBlock Text="时" Foreground="White" FontSize="18" FontWeight="SemiBold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="时光" Foreground="{DynamicResource HeaderTextBrush}" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="个人活动追踪 · 默认仅在本机处理" Foreground="{DynamicResource HeaderTextSecondaryBrush}" FontSize="12" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="{Binding ThemeToggleText}" Command="{Binding ToggleThemeCommand}"
                  Background="{DynamicResource HeaderBadgeBackgroundBrush}" Foreground="{DynamicResource HeaderBadgeForegroundBrush}"
                  CornerRadius="14" Padding="12,6" FontSize="12"
                  automation:AutomationProperties.Name="切换深色/浅色" />
          <Border Background="{DynamicResource HeaderBadgeBackgroundBrush}" CornerRadius="14" Padding="12,6">
            <TextBlock Text="{Binding CaptureStatus}" Foreground="{DynamicResource HeaderBadgeForegroundBrush}" FontSize="12" />
          </Border>
          <Border Background="{DynamicResource HeaderBadgeBackgroundBrush}" CornerRadius="14" Padding="12,6">
            <TextBlock Text="{Binding Voice.StatusText}" Foreground="{DynamicResource HeaderBadgeForegroundBrush}" FontSize="12" />
          </Border>
          <Button Content="退出" Command="{Binding RequestExitCommand}"
                  Background="{DynamicResource HeaderBadgeBackgroundBrush}" Foreground="{DynamicResource DangerForegroundBrush}"
                  CornerRadius="14" Padding="12,6" FontSize="12"
                  automation:AutomationProperties.Name="退出应用" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Margin="20" SelectedIndex="{Binding SelectedSectionIndex}" Background="Transparent"
                automation:AutomationProperties.Name="主导航">
      <TabItem Header="时间线" automation:AutomationProperties.Name="时间线" automation:AutomationProperties.AcceleratorKey="Ctrl+1">
        <Grid DataContext="{Binding Timeline}" x:DataType="vm:TimelineViewModel"
              ColumnDefinitions="360,*" Margin="0,12,0,0">
          <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="16" Margin="0,0,12,0">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
              <TextBlock Grid.Row="0" Text="活动记录" FontSize="15" FontWeight="SemiBold" />
              <ComboBox Grid.Row="1" ItemsSource="{Binding ActiveDates}" SelectedItem="{Binding SelectedDate}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,14,0,10">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:TimelineDateItem">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="搜索应用、标题或正文"
                         automation:AutomationProperties.Name="搜索应用、标题或正文" />
                <Button Grid.Column="1" Classes="secondary" Command="{Binding RefreshCommand}" Content="刷新" Margin="8,0,0,0"
                        automation:AutomationProperties.Name="刷新时间线" />
              </Grid>

              <Grid Grid.Row="3" Margin="0,14,0,0">
                <ListBox ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}"
                         Background="Transparent" BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:TimelineEventItem">
                      <Border Padding="10,9" CornerRadius="7" Margin="0,2">
                        <Grid ColumnDefinitions="62,*" RowDefinitions="Auto,Auto,Auto">
                          <TextBlock Grid.RowSpan="3" Text="{Binding TimeText}" FontFamily="Consolas" FontSize="12"
                                     Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Top" Margin="0,2,8,0" />
                          <TextBlock Grid.Column="1" Text="{Binding AppName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Title}" TextWrapping="Wrap"
                                     MaxHeight="40" FontSize="12" Margin="0,3,0,0" />
                          <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding SourceText}" FontSize="12"
                                     Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="暂无可显示的活动" Foreground="{DynamicResource MutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding !HasSelectedEvent}" />
                <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" IsVisible="{Binding IsLoading}" />
              </Grid>

              <StackPanel Grid.Row="4" Margin="0,12,0,0" Spacing="5">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{DynamicResource DangerForegroundBrush}" TextWrapping="Wrap"
                           IsVisible="{Binding HasError}" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="24">
            <Grid RowDefinitions="Auto,*">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel DataContext="{Binding SelectedEvent}" x:DataType="vm:TimelineEventItem" IsVisible="{Binding $parent[Grid].DataContext.HasSelectedEvent}">
                  <TextBlock Text="{Binding AppName}" FontSize="13" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,4" />
                  <TextBlock Text="{Binding CapturedTimeText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource AccentSoftBackgroundBrush}" CornerRadius="6" Padding="9,5" VerticalAlignment="Top">
                  <TextBlock Text="LOCAL ONLY" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                </Border>
              </Grid>

              <ScrollViewer Grid.Row="1" Margin="0,20,0,0">
                <StackPanel Spacing="16">
                  <Border Background="{DynamicResource SubtleCardBrush}" CornerRadius="8" Padding="14" IsVisible="{Binding HasSelectedEvent}">
                    <StackPanel DataContext="{Binding SelectedEvent}" x:DataType="vm:TimelineEventItem" Spacing="8">
                      <TextBlock Text="活动内容" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" IsVisible="{Binding HasDetailText}" />
                      <TextBlock Text="该事件没有提取文本或摘要。" Foreground="{DynamicResource MutedBrush}"
                                 IsVisible="{Binding !HasDetailText}" />
                    </StackPanel>
                  </Border>

                  <StackPanel IsVisible="{Binding HasSelectedEvent}" Spacing="8">
                    <TextBlock Text="媒体预览" FontWeight="SemiBold" />
                    <TextBlock DataContext="{Binding SelectedEvent}" x:DataType="vm:TimelineEventItem"
                               Text="{Binding MediaSizeText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                    <Border Background="{DynamicResource PlaceholderBrush}" BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1" CornerRadius="8" MinHeight="180" ClipToBounds="True"
                            IsVisible="{Binding HasPreview}">
                      <Image Source="{Binding PreviewImage}" Stretch="Uniform" MaxHeight="500" />
                    </Border>
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsPreviewLoading}" />
                    <Border Background="{DynamicResource WarningBackgroundBrush}" CornerRadius="7" Padding="12" IsVisible="{Binding HasPreviewError}">
                      <TextBlock Text="{Binding PreviewError}" Foreground="{DynamicResource WarningForegroundBrush}" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Text="此事件没有关联媒体。" Foreground="{DynamicResource MutedBrush}" IsVisible="{Binding HasNoMedia}" />
                  </StackPanel>

                  <StackPanel IsVisible="{Binding !HasSelectedEvent}" HorizontalAlignment="Center" Margin="0,100,0,0" Spacing="8">
                    <TextBlock Text="选择左侧事件开始回看" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="媒体只在选中时解密，明文不会写入临时文件" Foreground="{DynamicResource MutedBrush}" />
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="检索与问答" automation:AutomationProperties.Name="检索与问答" automation:AutomationProperties.AcceleratorKey="Ctrl+2">
        <Grid DataContext="{Binding Search}" x:DataType="vm:SearchViewModel"
              ColumnDefinitions="400,*" Margin="0,12,0,0">
          <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="18" Margin="0,0,12,0">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
              <TextBlock Text="证据检索与问答" FontSize="18" FontWeight="SemiBold" />
              <StackPanel Grid.Row="1" Spacing="8" Margin="0,14,0,0">
                <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="输入关键词或问题，例如：迁移进展如何"
                         automation:AutomationProperties.Name="检索关键词或问题" />
                <Grid RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                  <Grid Grid.Row="0" ColumnDefinitions="40,*" VerticalAlignment="Center">
                    <TextBlock Text="从" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    <DatePicker Grid.Column="1" SelectedDate="{Binding FromDate}" Initialized="OnDatePickerInitialized" />
                  </Grid>
                  <Grid Grid.Row="1" ColumnDefinitions="40,*" VerticalAlignment="Center" Margin="0,6,0,0">
                    <TextBlock Text="到" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    <DatePicker Grid.Column="1" SelectedDate="{Binding ToDate}" Initialized="OnDatePickerInitialized" />
                  </Grid>
                </Grid>
              </StackPanel>
              <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                <Button Classes="primary" Content="检索证据" Command="{Binding SearchCommand}" Margin="0,0,8,8"
                        automation:AutomationProperties.Name="检索证据" />
                <Button Classes="secondary" Content="提问" Command="{Binding AskCommand}" Margin="0,0,8,8"
                        automation:AutomationProperties.Name="基于证据提问" />
                <Button Classes="secondary" Content="导出问答" Command="{Binding ExportAnswerCommand}"
                        IsEnabled="{Binding HasAnswer}" Margin="0,0,8,8" />
              </WrapPanel>
              <ProgressBar Grid.Row="3" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
              <StackPanel Grid.Row="4" Spacing="5" Margin="0,8,0,0">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{DynamicResource DangerForegroundBrush}" TextWrapping="Wrap"
                           IsVisible="{Binding HasError}" />
              </StackPanel>
              <Border Grid.Row="5" Background="{DynamicResource SubtleCardBrush}" CornerRadius="8" Padding="12" Margin="0,14,0,0">
                <StackPanel Spacing="6">
                  <TextBlock Text="回答（仅基于证据）" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Answer}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding AnswerMeta}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                  <Border Background="{DynamicResource SuccessBackgroundBrush}" CornerRadius="6" Padding="10">
                    <TextBlock Text="无证据时不会生成推测性回答；原始媒体清理后只保留结构化证据。"
                               FontSize="12" Foreground="{DynamicResource SuccessForegroundBrush}" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="18">
            <Grid RowDefinitions="Auto,*,Auto">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="证据列表" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="点击“定位”跳转到时间线对应记录"
                           FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
              </Grid>
              <ScrollViewer Grid.Row="1" Margin="0,10,0,0">
                <ItemsControl ItemsSource="{Binding Evidence}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:EvidenceCardItem">
                      <Border Background="{DynamicResource SubtleCardBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Header}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Excerpt}" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding MatchedByText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock Text="{Binding MediaText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                          </StackPanel>
                          <Button Grid.Column="1" Classes="secondary" Content="定位"
                                  Command="{Binding NavigateCommand}" VerticalAlignment="Top"
                                  automation:AutomationProperties.Name="定位到时间线对应记录" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <Border Grid.Row="2" Background="{DynamicResource SubtleCardBrush}" CornerRadius="8" Padding="14" Margin="0,10,0,0">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Text="周报与统计" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="secondary" Content="生成周报"
                            Command="{Binding WeeklyReportCommand}" Margin="0,0,8,0" />
                    <Button Grid.Column="2" Classes="secondary" Content="导出"
                            Command="{Binding ExportWeeklyCommand}" IsEnabled="{Binding HasWeeklyReport}" />
                  </Grid>
                  <TextBlock Text="{Binding WeeklyStatus}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                  <ItemsControl ItemsSource="{Binding WeeklyBars}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DailyBarItem">
                        <Grid ColumnDefinitions="56,*,90" Margin="0,2">
                          <TextBlock Text="{Binding DateText}" FontSize="12" VerticalAlignment="Center" />
                          <Border Grid.Column="1" Height="14" Background="{DynamicResource AccentBrush}"
                                  CornerRadius="3" HorizontalAlignment="Left" Width="{Binding BarWidthPixels}" />
                          <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="12"
                                     Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBox Text="{Binding WeeklyMarkdown}" IsReadOnly="True" AcceptsReturn="True"
                           MaxHeight="190" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="隐私与控制" automation:AutomationProperties.Name="隐私与控制" automation:AutomationProperties.AcceleratorKey="Ctrl+3">
        <ScrollViewer DataContext="{Binding Capture}" x:DataType="vm:CaptureControlViewModel" Margin="0,12,0,0">
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
            <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="24" Margin="0,0,8,12">
              <StackPanel Spacing="14">
                <TextBlock Text="采集状态" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding CaptureStateText}" FontSize="15" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="暂停会立即阻断入口并清空待处理队列。恢复后不会补写暂停期间的活动。"
                           TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                <WrapPanel>
                  <Button Classes="primary" Content="{Binding PauseButtonText}" Command="{Binding TogglePauseCommand}" Margin="0,0,8,8" />
                  <Button Classes="secondary" Content="立即快照" Command="{Binding CaptureSnapshotCommand}" Margin="0,0,8,8" />
                </WrapPanel>
                <TextBlock Text="{Binding MetricsText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
              </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="24" Margin="8,0,0,12">
              <StackPanel Spacing="14">
                <TextBlock Text="开机与隐私" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding AutoStartText}" />
                <Button Classes="secondary" Content="切换开机自启" Command="{Binding ToggleAutoStartCommand}" HorizontalAlignment="Left" />
                <Border Background="{DynamicResource SuccessBackgroundBrush}" CornerRadius="8" Padding="14">
                  <TextBlock Text="数据库使用 SQLite3MC 加密，媒体使用 AES-GCM 加密；密钥由系统密钥库保护。默认不监视全盘、不记录按键或剪贴板。"
                             TextWrapping="Wrap" Foreground="{DynamicResource SuccessForegroundBrush}" />
                </Border>
              </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="24">
              <StackPanel Spacing="12">
                <TextBlock Text="应用与窗口黑名单" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="每行一个关键字，匹配应用名或窗口标题，不区分大小写。密码管理器与隐私浏览的内置规则也会显示在下方。"
                           TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                <TextBox Text="{Binding BlacklistText}" AcceptsReturn="True" MinHeight="170" TextWrapping="NoWrap" />
                <Button Classes="primary" Content="保存并立即生效" Command="{Binding SaveBlacklistCommand}" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="语音" automation:AutomationProperties.Name="语音" automation:AutomationProperties.AcceleratorKey="Ctrl+4">
        <Grid DataContext="{Binding Voice}" x:DataType="vm:VoiceControlViewModel"
              ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,12,0,0">
          <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="24" Margin="0,0,8,12">
            <StackPanel Spacing="14">
              <TextBlock Text="本地语音命令" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="{Binding StatusText}" FontSize="15" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="唤醒词：你好时光。唤醒后 8 秒内说出固定命令，命令音频默认仅驻留内存。"
                         TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
              <WrapPanel>
                <Button Classes="primary" Content="{Binding ToggleButtonText}" Command="{Binding ToggleCommand}" Margin="0,0,8,8" />
              </WrapPanel>
              <CheckBox Content="记录命令音频（加密留存，可自动清理）"
                        IsChecked="{Binding RecordsCommandAudio, Mode=OneWay}"
                        Command="{Binding ToggleCommandAudioCommand}"
                        automation:AutomationProperties.Name="记录命令音频" />
              <TextBlock Text="{Binding CommandAudioStatus}" TextWrapping="Wrap" FontSize="12"
                         Foreground="{DynamicResource MutedBrush}" />
              <TextBlock Text="{Binding CapabilityText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
              <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource DangerForegroundBrush}" IsVisible="{Binding HasError}" />
            </StackPanel>
          </Border>
          <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="24" Margin="8,0,0,12">
            <StackPanel Spacing="14">
              <TextBlock Text="最近一次交互" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="识别文本" FontWeight="SemiBold" />
              <TextBlock Text="{Binding LastTranscript}" TextWrapping="Wrap" />
              <TextBlock Text="反馈" FontWeight="SemiBold" />
              <TextBlock Text="{Binding LastFeedback}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
              <Border Background="{DynamicResource SuccessBackgroundBrush}" CornerRadius="8" Padding="14">
                <TextBlock Text="固定命令：生成日报、暂停采集、恢复采集、打开时间线、打开日报；以“问一下”开头可对近 7 天本地证据提问，回答与检索面板共用同一证据用例。退出应用需要二次确认。"
                           TextWrapping="Wrap" Foreground="{DynamicResource SuccessForegroundBrush}" />
              </Border>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="数据与导出" automation:AutomationProperties.Name="数据与导出" automation:AutomationProperties.AcceleratorKey="Ctrl+5">
        <Grid DataContext="{Binding Data}" x:DataType="vm:DataManagementViewModel"
              ColumnDefinitions="*,*" Margin="0,12,0,0">
          <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="24" Margin="0,0,8,0">
            <StackPanel Spacing="14">
              <TextBlock Text="删除本地数据" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="{Binding RetentionNotice}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
              <DatePicker SelectedDate="{Binding SelectedDate}" Initialized="OnDatePickerInitialized" />
              <WrapPanel>
                <Button Classes="secondary" Content="{Binding DeleteDateButtonText}"
                        Command="{Binding DeleteDateCommand}" Margin="0,0,8,8"
                        automation:AutomationProperties.Name="{Binding DeleteDateButtonText}" />
                <Button Classes="secondary" Content="{Binding DeleteAllButtonText}"
                        Command="{Binding DeleteAllCommand}" Margin="0,0,8,8"
                        automation:AutomationProperties.Name="{Binding DeleteAllButtonText}" />
                <Button Classes="secondary" Content="取消" Command="{Binding CancelPendingCommand}"
                        IsVisible="{Binding HasPending}" Margin="0,0,8,8" />
              </WrapPanel>
              <Border Background="{DynamicResource DangerBackgroundBrush}" CornerRadius="8" Padding="12" IsVisible="{Binding HasPending}">
                <TextBlock Text="{Binding PendingText}" Foreground="{DynamicResource DangerForegroundBrush}" TextWrapping="Wrap" />
              </Border>
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
              <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerForegroundBrush}" TextWrapping="Wrap"
                         IsVisible="{Binding HasError}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="24" Margin="8,0,0,0">
            <StackPanel Spacing="14">
              <TextBlock Text="导出与保留" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ExportNotice}" TextWrapping="Wrap" />
              <Border Background="{DynamicResource SuccessBackgroundBrush}" CornerRadius="8" Padding="14">
                <TextBlock Text="所有导出均在本机生成，不经过云端。删除数据前请先导出需要保留的日报与问答。"
                           TextWrapping="Wrap" Foreground="{DynamicResource SuccessForegroundBrush}" />
              </Border>
              <TextBlock Text="键盘快捷键：Ctrl+D1…D7 切换页面，Ctrl+F 打开检索，F5 刷新当前页。"
                         TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="本地诊断" automation:AutomationProperties.Name="本地诊断" automation:AutomationProperties.AcceleratorKey="Ctrl+6">
        <ScrollViewer DataContext="{Binding Diagnostics}" x:DataType="vm:DiagnosticsViewModel" Margin="0,12,0,0">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
              <StackPanel>
                <TextBlock Text="系统健康与能力矩阵" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding PlatformName}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
              </StackPanel>
              <Button Grid.Column="1" Classes="secondary" Content="生成脱敏导出预览" Command="{Binding GeneratePreviewCommand}" Margin="0,0,8,0" />
              <Button Grid.Column="2" Classes="secondary" Content="确认导出" Command="{Binding ExportPreviewCommand}" Margin="0,0,8,0" />
              <Button Grid.Column="3" Classes="primary" Content="重新检查" Command="{Binding RefreshCommand}"
                      automation:AutomationProperties.Name="重新检查平台能力" />
            </Grid>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
            <Border Background="{DynamicResource DangerBackgroundBrush}" CornerRadius="8" Padding="14" IsVisible="{Binding HasError}">
              <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerForegroundBrush}" TextWrapping="Wrap" />
            </Border>
            <Grid ColumnDefinitions="*,*,*">
              <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="18" Margin="0,0,6,0">
                <StackPanel Spacing="7">
                  <TextBlock Text="加密数据库" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding DatabaseText}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="18" Margin="6,0,6,0">
                <StackPanel Spacing="7">
                  <TextBlock Text="采集管道" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding PipelineText}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="18" Margin="6,0,0,0">
                <StackPanel Spacing="7">
                  <TextBlock Text="媒体保留清理" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding RetentionText}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
              </Border>
            </Grid>
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="18">
              <StackPanel Spacing="7">
                <TextBlock Text="本机模型网关" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ModelText}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="{Binding ModelEndpointsText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                <Border Background="{DynamicResource SubtleCardBrush}" CornerRadius="8" Padding="12" IsVisible="{Binding HasModelConfiguration}">
                  <StackPanel Spacing="8">
                    <TextBlock Text="模型配置" FontWeight="SemiBold" />
                    <TextBlock Text="对话与 Embedding 可独立配置端点（本机/内网/公网），保存后重启应用生效。" FontSize="12"
                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />

                    <TextBlock Text="对话模型" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                      <TextBlock Text="模型来源" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                      <ComboBox Grid.Column="1" ItemsSource="{Binding TierOptions}" SelectedItem="{Binding ChatTier}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,6">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBlock Grid.Row="1" Text="模型名" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ChatModel}" PlaceholderText="例如 gemma4:12b" Margin="0,0,0,6" />
                      <TextBlock Grid.Row="2" Text="Base URL" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                      <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ChatBaseUrl}" PlaceholderText="http://127.0.0.1:11434" Margin="0,0,0,6" />
                    </Grid>

                    <TextBlock Text="Embedding 模型" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                      <TextBlock Text="模型来源" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                      <ComboBox Grid.Column="1" ItemsSource="{Binding TierOptions}" SelectedItem="{Binding EmbeddingTier}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,6">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBlock Grid.Row="1" Text="模型名" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EmbeddingModel}" PlaceholderText="例如 embeddinggemma-2:740m" Margin="0,0,0,6" />
                      <TextBlock Grid.Row="2" Text="Base URL" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                      <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EmbeddingBaseUrl}" PlaceholderText="http://127.0.0.1:11434" Margin="0,0,0,6" />
                    </Grid>

                    <WrapPanel>
                      <Button Classes="primary" Content="保存模型配置" Command="{Binding SaveModelConfigurationCommand}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding ModelConfigStatus}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="18" IsVisible="{Binding HasMcpControl}">
              <StackPanel Spacing="8">
                <TextBlock Text="只读本地 MCP（默认关闭）" FontWeight="SemiBold" />
                <TextBlock Text="{Binding McpStatusText}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="仅暴露 search_events、activity_stats、list_reports、get_report 四个只读工具；无写工具，强制 loopback 与本地令牌。"
                           TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                <TextBox Text="{Binding McpTokenText}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                <WrapPanel>
                  <Button Classes="secondary" Content="显示令牌" Command="{Binding RevealMcpTokenCommand}" Margin="0,0,8,8" />
                  <Button Classes="secondary" Content="轮换令牌" Command="{Binding RotateMcpTokenCommand}" Margin="0,0,8,8" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="18" IsVisible="{Binding HasSecretAdmin}">
              <StackPanel Spacing="8">
                <TextBlock Text="模型端点密钥" FontWeight="SemiBold" />
                <TextBlock Text="密钥以 AES-GCM 加密保存在本机；写入后不可读取，models.json 通过 apiKeySecret 引用名称。"
                           TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                <Grid ColumnDefinitions="*,*">
                  <TextBox Text="{Binding SecretName}" PlaceholderText="密钥名称，例如 corp-api-key" Margin="0,0,6,0" />
                  <TextBox Grid.Column="1" Text="{Binding SecretValue}" PasswordChar="●" PlaceholderText="密钥值" Margin="6,0,0,0" />
                </Grid>
                <WrapPanel>
                  <Button Classes="primary" Content="保存密钥" Command="{Binding SaveSecretCommand}" Margin="0,0,8,8" />
                  <Button Classes="secondary" Content="刷新列表" Command="{Binding RefreshSecretsCommand}" Margin="0,0,8,8" />
                  <Button Classes="secondary" Content="删除选中" Command="{Binding DeleteSecretCommand}" Margin="0,0,8,8" />
                </WrapPanel>
                <ListBox ItemsSource="{Binding SecretNames}" SelectedItem="{Binding SelectedSecret}"
                         MaxHeight="120" Background="Transparent" BorderThickness="0" />
                <TextBlock Text="{Binding SecretStatus}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="18" IsVisible="{Binding HasExportPreview}">
              <StackPanel Spacing="8">
                <TextBlock Text="诊断导出预览（仅元数据，用户确认前不写外部文件）" FontWeight="SemiBold" />
                <TextBox Text="{Binding ExportPreviewJson}" IsReadOnly="True" AcceptsReturn="True" MaxHeight="180" FontFamily="Consolas" FontSize="12" />
                <TextBlock Text="{Binding ExportStatusText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="18">
              <StackPanel Spacing="8">
                <TextBlock Text="权限引导" FontWeight="SemiBold" />
                <TextBlock Text="{Binding PermissionGuidanceText}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="18">
              <StackPanel Spacing="10">
                <TextBlock Text="平台能力" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Capabilities}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CapabilityItem">
                      <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                        <Grid ColumnDefinitions="130,85,*,260">
                          <TextBlock Text="{Binding KindText}" FontWeight="SemiBold" />
                          <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{DynamicResource AccentBrush}" />
                          <TextBlock Grid.Column="2" Text="{Binding Summary}" TextWrapping="Wrap" Margin="8,0" />
                          <TextBlock Grid.Column="3" Text="{Binding RemediationHint}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="18">
              <StackPanel Spacing="10">
                <TextBlock Text="最近后台任务" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding RecentJobs}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReportJobItem">
                      <Grid ColumnDefinitions="120,120,100,*" Margin="0,5">
                        <TextBlock Text="{Binding DateText}" />
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" />
                        <TextBlock Grid.Column="2" Text="{Binding AttemptText}" />
                        <TextBlock Grid.Column="3" Text="{Binding CreatedText}" Foreground="{DynamicResource MutedBrush}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="18">
              <StackPanel Spacing="10">
                <TextBlock Text="最近脱敏结构化日志" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding RecentLogs}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DiagnosticLogItem">
                      <Grid ColumnDefinitions="80,90,150,*" Margin="0,4">
                        <TextBlock Text="{Binding TimeText}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding LevelText}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="{Binding CategoryText}" FontSize="12" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{Binding MessageText}" FontSize="12" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding LastRefreshText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="日报" automation:AutomationProperties.Name="日报" automation:AutomationProperties.AcceleratorKey="Ctrl+7">
        <Grid DataContext="{Binding Reports}" x:DataType="vm:ReportsViewModel"
              ColumnDefinitions="360,*" Margin="0,12,0,0">
          <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="18" Margin="0,0,12,0">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
              <TextBlock Text="日报与站会" FontSize="18" FontWeight="SemiBold" />
              <DatePicker Grid.Row="1" SelectedDate="{Binding SelectedDate}" Margin="0,14,0,10" Initialized="OnDatePickerInitialized" />
              <WrapPanel Grid.Row="2" Margin="0,0,0,12">
                <Button Classes="primary" Content="生成日报" Command="{Binding GenerateCommand}" Margin="0,0,8,8" />
                <Button Classes="secondary" Content="强制重生成" Command="{Binding RegenerateCommand}" Margin="0,0,8,8" />
                <Button Classes="secondary" Content="刷新" Command="{Binding RefreshCommand}" Margin="0,0,8,8" />
              </WrapPanel>
              <Grid Grid.Row="3">
                <ListBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"
                         Background="Transparent" BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReportVersionItem">
                      <TextBlock Text="{Binding DisplayText}" Padding="6,8" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" IsVisible="{Binding IsBusy}" />
              </Grid>
              <StackPanel Grid.Row="4" Spacing="5" Margin="0,12,0,0">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerForegroundBrush}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="22">
            <Grid RowDefinitions="Auto,Auto,*">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="日报正文" FontSize="20" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding VersionText}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Classes="secondary" Content="导出 Markdown"
                        Command="{Binding ExportCommand}" IsEnabled="{Binding HasReport}" />
              </Grid>
              <Border Grid.Row="1" Background="{DynamicResource SubtleCardBrush}" CornerRadius="8" Padding="14" Margin="0,14,0,12">
                <StackPanel Spacing="6">
                  <TextBlock Text="站会视图" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding StandupText}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <ScrollViewer Grid.Row="2">
                <TextBox Text="{Binding Markdown}" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                         Background="Transparent" BorderThickness="0" MinHeight="360" />
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
