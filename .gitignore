# AiAssistant 仓库忽略规则（精简版：只保留本仓实际会产生的文件）
# 反例：不要恢复 VS6 / Silverlight / LightSwitch / BizTalk / Bower / StyleCop 等历史模板规则。

# 统一产物布局：所有构建、发布、SBOM、证据、模型缓存都落在 artifacts/。
artifacts/
.artifacts/

# 历史布局残留（迁移前的工作树可能仍有 bin/、obj/）。
**/[Bb]in/
**/[Oo]bj/
[Dd]ebug/
[Rr]elease/

# .NET / NuGet
project.lock.json
project.fragment.lock.json
TestResults/
*.trx
*.binlog
MSBuild_Logs/
*.nupkg
*.snupkg
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info

# 原生与脚本工具链
.build/
native/**/.build/
.swiftpm/
__pycache__/
*.py[cod]
.venv/
node_modules/

# IDE / 编辑器
.vs/
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.user
*.suo
*.userosscache
*.sln.docstates
.DS_Store
Thumbs.db
*~

# 安装包与密钥材料（仅产物；源码资产 PNG/ICO 仍然入库）
*.msi
*.msix
*.msixbundle
*.deb
*.pkg
*.zip
*.tar.gz
*.pfx
*.key
*.pem
*.env

# 本地 AI 工作区状态（docs/status/ 下的文档才是随仓库交接的单一事实源）
.workbuddy/
.workbuddy-ai/

# 本机语音与 OCR 模型资产永不入库；汇总/打包它们的脚本要入库。
models/
!build/models/
!build/models/*.sh
*.onnx
models.json
