<Project>
  <!--
    本文件只放“后处理”类 MSBuild 逻辑：输出布局修正、跨平台 RID 原生资产裁剪与发布清单。
    全局属性统一放在 Directory.Build.props；两者不得混放，便于审阅与逐项回滚。
  -->

  <!-- .NET SDK 的 artifacts 布局把中间产物放到 artifacts/obj/<Project>/<pivot>。
       审计与 SBOM 生成器据此收敛路径，源码树下不再出现 bin/、obj/。 -->
  <PropertyGroup>
    <ArtifactsObjRoot Condition="'$(ArtifactsObjRoot)' == ''">$(ArtifactsPath)/obj/</ArtifactsObjRoot>
  </PropertyGroup>

  <!-- 原生资产按 RID 隔离：只保留当前 RID 需要的运行库，避免跨 RID 二进制混入包体。 -->
  <Target Name="AiAssistantTrimForeignRidAssets"
          AfterTargets="Build"
          Condition="'$(RuntimeIdentifier)' != '' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_AiAssistantForeignRidNative Include="@(NativeCopyLocalItems)"
                                    Condition="'%(NativeCopyLocalItems.RuntimeIdentifier)' != '' and '%(NativeCopyLocalItems.RuntimeIdentifier)' != '$(RuntimeIdentifier)'" />
      <NativeCopyLocalItems Remove="@(_AiAssistantForeignRidNative)" />
      <_AiAssistantForeignRidResource Include="@(ResourceCopyLocalItems)"
                                      Condition="'%(ResourceCopyLocalItems.RuntimeIdentifier)' != '' and '%(ResourceCopyLocalItems.RuntimeIdentifier)' != '$(RuntimeIdentifier)'" />
      <ResourceCopyLocalItems Remove="@(_AiAssistantForeignRidResource)" />
    </ItemGroup>
  </Target>

  <!-- 发布清单：把实际随包原生依赖写成文本证据，便于交付审计与 SBOM 交叉核对。 -->
  <Target Name="AiAssistantWritePublishManifest"
          AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' != '' and '$(PublishDir)' != ''">
    <PropertyGroup>
      <_AiAssistantManifestDir>$([MSBuild]::EnsureTrailingSlash('$(ArtifactsPath)'))publish/$(RuntimeIdentifier)/</_AiAssistantManifestDir>
      <_AiAssistantManifestFile>$(_AiAssistantManifestDir)publish-manifest.txt</_AiAssistantManifestFile>
    </PropertyGroup>
    <MakeDir Directories="$(_AiAssistantManifestDir)" />
    <WriteLinesToFile File="$(_AiAssistantManifestFile)"
                      Lines="@(ResolvedFileToPublish->'%(Filename)%(Extension)')"
                      Overwrite="true"
                      Encoding="UTF-8" />
  </Target>
</Project>
