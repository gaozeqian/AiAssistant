<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="UI and MVVM">
    <PackageVersion Include="Avalonia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Wayland" Version="12.1.6" />
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.95.2" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <PackageVersion Include="PDFsharp" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup Label="Storage and Security">
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.15" />
    <PackageVersion Include="SQLite3MC.PCLRaw.bundle" Version="2.7.1" />
    <PackageVersion Include="HiraokaHyperTools.sqlite-vec" Version="0.1.9" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="Extensions and AI">
    <PackageVersion Include="Microsoft.Extensions.AI" Version="11.0.1" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="11.0.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageVersion Include="System.Numerics.Tensors" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup Label="Audio and Local Speech">
    <PackageVersion Include="org.k2fsa.sherpa.onnx" Version="2.0.2" />
    <PackageVersion Include="Whisper.net" Version="1.9.1" />
    <PackageVersion Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageVersion Include="NAudio" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup Label="Local Inference">
    <!-- Managed bindings only: the native ONNX Runtime is already shipped by sherpa-onnx (1.28.2).
         Adding Microsoft.ML.OnnxRuntime would overwrite it with a newer SONAME and break sherpa. -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.28.0" />
  </ItemGroup>

  <ItemGroup Label="Testing (Microsoft.Testing.Platform / xunit.v3)">
    <!-- xunit.v3 3.x 使用 MTP v1（当前解析到 Microsoft.Testing.Platform 1.9.1），
         兼容 .NET 10 的 MTP dotnet test 模式（要求 MTP >= 1.7）。
         不再引用 Microsoft.NET.Test.Sdk / xunit.runner.visualstudio / coverlet.collector。 -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="17.14.2" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>
</Project>
